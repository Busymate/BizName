# Copy this file to `supabase/functions/.env` (gitignored — never commit
# it, never zip it up) to test the ai-assistant function locally:
#
#   supabase functions serve ai-assistant --env-file supabase/functions/.env
#
# For a deployed (production) function, don't use this file at all —
# use `supabase secrets set KEY=value` instead, which is the only place
# these values should live once you're not just testing locally.

GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=